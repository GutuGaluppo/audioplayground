{
  "$comment": "Single source of truth for UI <-> native messages (ADR-003). Edit this file, then run `pnpm codegen`. Never edit generated files.",
  "protocolVersion": 1,
  "intents": {
    "app.ready": {},
    "audio.openSettings": {},
    "tone.setEnabled": {
      "enabled": {
        "type": "bool"
      }
    },
    "transport.play": {},
    "transport.stop": {},
    "transport.returnToStart": {},
    "transport.setTempo": {
      "bpm": {
        "type": "number",
        "min": 20,
        "max": 300
      }
    },
    "transport.setCountIn": {
      "bars": {
        "type": "int",
        "min": 0,
        "max": 4
      }
    },
    "metronome.setEnabled": {
      "enabled": {
        "type": "bool"
      }
    },
    "param.set": {
      "id": {
        "type": "string",
        "maxLength": 64
      },
      "value": {
        "type": "number",
        "min": -1000000,
        "max": 1000000
      },
      "gesture": {
        "type": "int",
        "min": 0,
        "max": 2147483647
      }
    },
    "edit.undo": {},
    "edit.redo": {},
    "project.new": {},
    "project.open": {},
    "project.save": {},
    "project.saveAs": {},
    "project.rename": {
      "name": {
        "type": "string",
        "maxLength": 512
      }
    }
  },
  "events": {
    "engine.status": {
      "deviceName": {
        "type": "string",
        "maxLength": 256
      },
      "sampleRate": {
        "type": "number",
        "min": 0,
        "max": 768000
      },
      "bufferSize": {
        "type": "int",
        "min": 0,
        "max": 65536
      },
      "outputLatencyMs": {
        "type": "number",
        "min": 0,
        "max": 10000
      },
      "error": {
        "type": "string",
        "maxLength": 1024
      },
      "toneEnabled": {
        "type": "bool"
      }
    },
    "engine.meters": {
      "peak": {
        "type": "number",
        "min": 0,
        "max": 1
      }
    },
    "transport.state": {
      "playing": {
        "type": "bool"
      },
      "bpm": {
        "type": "number",
        "min": 20,
        "max": 300
      },
      "numerator": {
        "type": "int",
        "min": 1,
        "max": 32
      },
      "denominator": {
        "type": "int",
        "min": 1,
        "max": 16
      },
      "countInBars": {
        "type": "int",
        "min": 0,
        "max": 4
      },
      "metronomeEnabled": {
        "type": "bool"
      }
    },
    "transport.position": {
      "bar": {
        "type": "int",
        "min": -1000,
        "max": 100000000
      },
      "beat": {
        "type": "int",
        "min": 1,
        "max": 32
      },
      "countingIn": {
        "type": "bool"
      }
    },
    "param.value": {
      "id": {
        "type": "string",
        "maxLength": 64
      },
      "value": {
        "type": "number",
        "min": -1000000,
        "max": 1000000
      }
    },
    "history.state": {
      "canUndo": {
        "type": "bool"
      },
      "canRedo": {
        "type": "bool"
      },
      "undoLabel": {
        "type": "string",
        "maxLength": 64
      },
      "redoLabel": {
        "type": "string",
        "maxLength": 64
      }
    },
    "project.state": {
      "name": {
        "type": "string",
        "maxLength": 512
      },
      "dirty": {
        "type": "bool"
      },
      "hasLocation": {
        "type": "bool"
      }
    },
    "app.notice": {
      "level": {
        "type": "int",
        "min": 0,
        "max": 2
      },
      "message": {
        "type": "string",
        "maxLength": 1024
      }
    }
  }
}
